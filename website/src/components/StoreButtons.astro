---
import type { Project } from '../data/projects';

interface Props {
  links: Project['links'];
}
const { links } = Astro.props;
---

<div class="stores">
  {links.appStore && (
    <a class="btn dark" href={links.appStore} target="_blank" rel="noopener">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.37 12.6c-.02-2.3 1.88-3.4 1.96-3.46-1.07-1.56-2.73-1.78-3.32-1.8-1.41-.14-2.76.83-3.47.83-.72 0-1.82-.81-2.99-.79-1.54.02-2.96.9-3.75 2.27-1.6 2.78-.41 6.89 1.15 9.14.76 1.1 1.67 2.34 2.86 2.3 1.15-.05 1.58-.74 2.97-.74 1.38 0 1.77.74 2.98.72 1.23-.02 2.01-1.12 2.76-2.23.87-1.28 1.23-2.52 1.25-2.58-.03-.01-2.4-.92-2.4-3.66zM14.1 5.86c.63-.77 1.06-1.83.94-2.89-.91.04-2.01.61-2.66 1.37-.58.67-1.1 1.76-.96 2.8 1.01.08 2.05-.52 2.68-1.28z"/></svg>
      App Store
    </a>
  )}
  {links.playStore && (
    <a class="btn" href={links.playStore} target="_blank" rel="noopener">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3.6 2.2c-.25.26-.4.67-.4 1.2v17.2c0 .53.15.94.4 1.2l.07.06L13.3 12.2v-.22L3.67 2.14l-.07.06zm12.9 13.2-3.2-3.2v-.22l3.2-3.2.07.04 3.8 2.16c1.08.62 1.08 1.63 0 2.25l-3.8 2.16-.07.01zm.08-.04L13.3 12.1 3.6 21.8c.36.38.95.43 1.62.05l11.36-6.49m0-6.72L5.22 2.15c-.67-.38-1.26-.33-1.62.05l9.7 9.7 3.28-3.26z"/></svg>
      Google Play
    </a>
  )}
  {links.website && (
    <a class="btn white" href={links.website} target="_blank" rel="noopener">Visit website ↗</a>
  )}
</div>

<style>
  .stores { display: flex; gap: 14px; flex-wrap: wrap; }
</style>
