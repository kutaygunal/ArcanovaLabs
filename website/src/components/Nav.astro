---
import { site } from '../data/site';
---

<nav>
  <div class="wrap nav-inner">
    <a href="/" class="logo display"><span class="logo-mark" aria-hidden="true">✺</span>{site.name}</a>
    <div class="nav-links">
      <a href="/#services">Services</a>
      <a href="/#work">Work</a>
      <a href="/#contact">Contact</a>
    </div>
    <a href="/#contact" class="btn nav-cta">Get a quote ↗</a>
  </div>
</nav>

<style>
  nav { border-bottom: var(--b); background: var(--bg); position: sticky; top: 0; z-index: 40; }
  .nav-inner { display: flex; justify-content: space-between; align-items: center; gap: 12px; height: 76px; }
  .logo { font-size: 22px; display: flex; align-items: center; gap: 10px; white-space: nowrap; }
  .logo-mark {
    width: 38px; height: 38px; background: var(--violet); border: var(--b); border-radius: 10px;
    display: grid; place-items: center; color: #fff; font-size: 20px; box-shadow: 3px 3px 0 var(--ink); flex-shrink: 0;
  }
  .nav-links { display: flex; gap: 8px; }
  .nav-links a { padding: 10px 16px; border: 3px solid transparent; border-radius: 10px; font-weight: 700; }
  .nav-links a:hover { border-color: var(--ink); background: var(--pink); }

  @media (max-width: 900px) {
    .nav-links { display: none; }
    .nav-cta { padding: 10px 14px; font-size: 14px; white-space: nowrap; }
  }
  @media (max-width: 400px) {
    .logo { font-size: 17px; }
  }
</style>
